# LLM - "groq" (default, local dev/tests, free) or "openai" (production, GPT-4o mini).
# Set LLM_PROVIDER=openai + LLM_MODEL=gpt-4o-mini + OPENAI_API_KEY only on Render.
LLM_PROVIDER=groq            # openai | gemini | anthropic | groq
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile   # or gpt-4o-mini / gemini-1.5-flash / claude-haiku-4-5-20251001

# RAG - "local" (default, local dev/tests, free, MiniLM) or "openai" (production,
# text-embedding-3-small, shares OPENAI_API_KEY above). Must be switched together with
# VECTOR_DB_BACKEND=qdrant below - the two backends store different vector dimensions
# (384 vs 1536) so mixing them silently breaks retrieval.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TOP_K_CHUNKS=5
# Tuned for local MiniLM embeddings. Once EMBEDDING_BACKEND=openai is live, re-test and
# re-tune both thresholds against real queries - OpenAI's cosine similarity distribution
# runs differently than MiniLM's, so these numbers will likely need to change too.
MIN_SIMILARITY_SCORE=0.30    # below this -> unknown question
LOW_CONFIDENCE_THRESHOLD=0.60 # below this -> low-confidence prefix added

# Vector DB - "chroma" (default, local dev/tests) or "qdrant" (production)
VECTOR_DB_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=geometra_faq

# Qdrant Cloud - used only when VECTOR_DB_BACKEND=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=geometra_faq

# Database
SQLITE_DB_PATH=./geometra_chat.db

# Supabase - escalated (relevant-but-unknown) questions land in the escalated_questions table
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend - automated ticket emails sent to SUPPORT_EMAIL when a question is escalated
RESEND_API_KEY=
RESEND_FROM_EMAIL=S.A.M <onboarding@resend.dev>

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
