# LLM - set whichever key is available (see Section 3 note)
LLM_PROVIDER=groq            # openai | gemini | anthropic | groq
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile   # or gpt-4o-mini / gemini-1.5-flash / claude-haiku-4-5-20251001

# RAG - local embedding model, no API key needed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=geometra_faq
TOP_K_CHUNKS=3
MIN_SIMILARITY_SCORE=0.30    # below this -> unknown question (tuned for local MiniLM embeddings)
LOW_CONFIDENCE_THRESHOLD=0.60 # below this -> low-confidence prefix added

# Database
SQLITE_DB_PATH=./geometra_chat.db

# Supabase - escalated (relevant-but-unknown) questions land in the escalated_questions table
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
