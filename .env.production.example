# Production environment for the S.A.M container.
#
#   cp .env.production.example .env.production   # then fill in the seven secrets
#   docker run --env-file .env.production -p 8000:8000 sam-backend
#
# This is the complete set of variables the live service runs with. Every one of the
# non-secret values below is what production is actually set to today - copied here so the
# container reproduces it rather than relying on defaults that may move.
#
# backend/startup_checks.py enforces most of this at boot: with APP_ENV=production, a
# missing credential or a development backend makes the container REFUSE TO START with a
# message naming every problem at once. That is deliberate. The alternative - which this
# project has lived through - is a service that starts, passes its health check, writes
# every conversation to a SQLite file inside the container, and loses all of it on the
# next restart.

# --------------------------------------------------------------------------- mode
# Turns on the strict startup assertions. Without it the container will happily run on
# development backends.
APP_ENV=production

# --------------------------------------------------------------------------- LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# SECRET. Also used for embeddings below - one key, two services.
OPENAI_API_KEY=

# --------------------------------------------------------------------------- embeddings
# Must stay in step with VECTOR_DB_BACKEND: the Qdrant collection holds 1536-dimension
# OpenAI vectors, and the local MiniLM alternative produces 384. Mixing them does not
# error, it just makes every query return nothing.
EMBEDDING_BACKEND=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 15, not the old 6: enough of the FAQ reaches the model at once to answer questions no
# single FAQ row covers. Raising it costs tokens on every request; lowering it has caused
# answerable questions to be refused.
TOP_K_CHUNKS=15
MIN_SIMILARITY_SCORE=0.30
LOW_CONFIDENCE_THRESHOLD=0.60

# --------------------------------------------------------------------------- vector DB
VECTOR_DB_BACKEND=qdrant
# SECRETS.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=geometra_faq

# --------------------------------------------------------------------------- database
DATABASE_BACKEND=supabase
# SECRETS. The service-role key bypasses row-level security, so it belongs only in the
# server's environment - never in the frontend, never in the repository.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------- FAQ source
# The knowledge base is a Google Sheet, re-read on every boot by the entrypoint and
# on demand by POST /admin/reingest. The sheet must be shared as "anyone with the link
# can view" for this to work at all.
FAQ_SOURCE=sheet
FAQ_SHEET_ID=1JTQYPycJhdxLXXbJAfbV4_lgYRMgB07Z5eaOhsS3CF0
# Empty means the first tab, which is what Google serves when gid is omitted. A pinned gid
# can go stale; this one did, pointing at a tab in the pre-conversion .xlsx.
FAQ_SHEET_GID=
# The mirror is authoritative - it removes chunks the sheet no longer has - so a fetch
# that parses fine but comes back nearly empty would delete the knowledge base. Below this
# many rows it refuses and leaves the previous contents alone. Sized well under the real
# row count and well above zero.
FAQ_MIN_ROWS=50

# --------------------------------------------------------------------------- re-ingest
# SECRET, and load-bearing in an unusual direction: POST /admin/reingest is DISABLED
# (503) while this is empty, because it spends money on embedding calls and replaces the
# live knowledge base. Set it to a long random string, and set the identical value as the
# INGEST_TOKEN secret in the spreadsheet's Apps Script trigger and in the GitHub Actions
# repository secrets (.github/workflows/faq_sync.yml), or new FAQ rows stop going live.
INGEST_TOKEN=

# --------------------------------------------------------------------------- email
# SECRET. With APP_ENV=production an empty key is a refusal to start: a customer could
# confirm a support ticket, have it written to the database, and nobody would be told.
RESEND_API_KEY=
RESEND_FROM_EMAIL=S.A.M <onboarding@resend.dev>
SUPPORT_EMAIL=satyav8.geometra@gmail.com

# --------------------------------------------------------------------------- HTTP
# The browser origin(s) the frontend is served from, comma separated. A localhost entry
# here is refused under APP_ENV=production - it almost always means the real origin was
# never filled in.
CORS_ORIGINS=https://geometra-frontend.onrender.com

# The image defaults to both of these; listed so they are visible rather than hidden.
# WEB_CONCURRENCY stays at 1: /chat is a sync endpoint, so each worker already carries a
# 40-thread pool, which is what llm/two_pass.py sizes its moderation pool against.
PORT=8000
WEB_CONCURRENCY=1
